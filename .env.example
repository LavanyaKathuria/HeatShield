# Backend only. Never use a VITE_ prefix for private keys.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Worker only; keep this in backend environment / secret storage.
SUPABASE_SERVICE_ROLE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SANDBOX_JOIN_CODE=
WHATSAPP_MODE=sandbox
# Production: JSON mapping language.group.level -> approved Twilio Content SID.
# Templates: {{1}}=ward, {{2}}=date, {{3}}=localized timing label.
WHATSAPP_TEMPLATES={}
ALERTS_DB_PATH=data/alerts.sqlite
# Start checks with the FastAPI server. False until deliberately enabled.
ALERTS_AUTOMATION_ENABLED=false
ALERTS_INTERVAL_SECONDS=60
WHATSAPP_FAILURE_RETRY_SECONDS=10800
# Limits count attempts, including errors, across scheduler, CLI and demo.
WHATSAPP_LIMITS_ENABLED=true
WHATSAPP_DAILY_LIMIT=3
WHATSAPP_TOTAL_LIMIT=10
