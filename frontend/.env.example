# Copy to `frontend/.env` and fill in. `.env` is gitignored.
#
# Vite exposes anything prefixed VITE_ to the BROWSER BUNDLE. Never put a
# secret here - assume every value in this file is public.

# Where the FastAPI backend is. Left unset in dev, because vite.config.ts
# proxies /api to localhost:8000 to avoid CORS.
# VITE_API_BASE_URL=https://your-api-host

# Supabase project URL and ANON key.
#
# The anon key is designed to be public - it ships in the browser bundle
# and is safe there BECAUSE row-level security restricts what it can
# reach. That safety depends entirely on RLS being correct.
#
# The SERVICE ROLE key bypasses row-level security completely. It must
# never appear in this file, in the frontend, or in any chat or email.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
